# Database — contains real staff/guest data and password hashes, never commit.
# The -wal and -shm files are part of the database in WAL mode and hold real
# committed rows; they were missing here and got staged by a `git add -A`.
*.db
*.db-journal
*.db-wal
*.db-shm

# Uploaded files — move to a Railway persistent volume, not the repo
uploads/
room_photos/
# Copies of the site's photographs, taken so the house stops depending on
# a Squarespace account it no longer publishes from. Ninety-three images
# is not a repository anybody can clone — they belong on the volume
# beside the database, which is where DATA_DIR puts them.
mirrored/

# Local runtime / logs
__pycache__/
*.pyc
_server_log.txt
_server_log.txt.err

# Environment / secrets
.env
.env.*
# One-off local admin script — contains a plaintext password, never commit
reset_owner_password.py
# Local-dev session signing key (see the __main__ block in app.py)
.dev_secret_key

# Editor / OS
.DS_Store

# Claude Code local session state
.claude/settings.local.json

# Generated by tools/export_for_design.py — a snapshot of the public pages to
# hand to whoever does the design work. Rebuilt on demand and always from
# current main, so a committed copy could only ever be a stale one.
gudanes-design-current.zip
