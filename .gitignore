# Database — contains real staff/guest data and password hashes, never commit.
# The -wal and -shm files are part of the database in WAL mode and hold real
# committed rows; they were missing here and got staged by a `git add -A`.
*.db
*.db-journal
*.db-wal
*.db-shm

# Uploaded files — move to a Railway persistent volume, not the repo
uploads/
room_photos/
# Copies of the site's photographs, taken so the house stops depending on
# a Squarespace account it no longer publishes from. Ninety-three images
# is not a repository anybody can clone — they belong on the volume
# beside the database, which is where DATA_DIR puts them.
mirrored/

# Local runtime / logs
__pycache__/
*.pyc
_server_log.txt
_server_log.txt.err

# Environment / secrets
.env
.env.*
# One-off local admin script — contains a plaintext password, never commit
reset_owner_password.py
# Local-dev session signing key (see the __main__ block in app.py)
.dev_secret_key

# Editor / OS
.DS_Store

# Claude Code local session state
.claude/settings.local.json

# Generated by tools/export_for_design.py — a snapshot of the public pages to
# hand to whoever does the design work. Rebuilt on demand and always from
# current main, so a committed copy could only ever be a stale one.
gudanes-design-current.zip

# Written by export_catalogue.py, for carrying rooms and extras to another
# install. A generated file, and the copy sitting here was already stale --
# it held the old Booking.com room names months after the rooms were renamed
# to the French ones. Regenerate it when it is wanted rather than keeping a
# version that quietly stops being true.
catalogue.json

# Everything the Squarespace account still holds, brought down by
# tools/harvest_photos.py so the photographs can be looked at and sorted.
# Several hundred pictures are not a repository anybody can clone.
photo_harvest/

# A list of untested routes, generated once by hand. tests/run.py works the
# same thing out on every run, from the run itself, so a kept copy is a
# second answer that goes stale.
_untested.txt

# The camera roll's card-reader key, generated for the owner to paste into
# .env themselves. One line, one copy, never in git.
INGEST-KEY.txt
