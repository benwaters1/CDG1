<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Gudanes add-in for Outlook. Served by the app at /outlook-addin/manifest.xml
  with this site's own addresses filled in.

  Two layers, as Microsoft's schema has them. VersionOverrides 1.0 is for an old
  Outlook that knows nothing newer: the two desktop buttons. VersionOverrides 1.1
  is what every current Outlook reads INSTEAD, so it repeats those buttons and
  adds what only it can carry: the phone (MobileFormFactor, read mode) and the
  events — a note when a guest is put in To, and the check on Send.

  Outlook caches a manifest by its Version. Change anything here, bump
  OUTLOOK_ADDIN_VERSION in app.py, or nobody who has it already sees the change.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>{{ guid }}</Id>
  <Version>{{ version }}</Version>
  <ProviderName>Chateau de Gudanes</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Gudanes"/>
  <Description DefaultValue="The whole guest beside their email: what they have booked, what to watch for, every email with them across the house's inboxes, and replies drafted from it."/>
  <IconUrl DefaultValue="{{ icons[64] }}"/>
  <HighResolutionIconUrl DefaultValue="{{ icons[128] }}"/>
  <SupportUrl DefaultValue="{{ support_url }}"/>
  <AppDomains>
    <AppDomain>{{ app_domain }}</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="{{ taskpane_url }}"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="{{ compose_taskpane_url }}"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <!-- Never lower than the base Requirements above (Mailbox 1.5): Microsoft
         rejects a manifest whose override asks for less than the base. This
         said 1.3 from August, sideloading let it through, and the Microsoft
         365 admin centre refused the upload on 13 October 2026. -->
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="msgReadOpenPaneButton">
                  <Label resid="PaneButtonLabel"/>
                  <Supertip>
                    <Title resid="PaneButtonLabel"/>
                    <Description resid="PaneButtonTooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgComposeGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="msgComposeOpenPaneButton">
                  <Label resid="ComposePaneButtonLabel"/>
                  <Supertip>
                    <Title resid="ComposePaneButtonLabel"/>
                    <Description resid="ComposePaneButtonTooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="ComposeTaskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="{{ icons[16] }}"/>
        <bt:Image id="Icon.32x32" DefaultValue="{{ icons[32] }}"/>
        <bt:Image id="Icon.80x80" DefaultValue="{{ icons[80] }}"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="{{ launchevent_html_url }}"/>
        <bt:Url id="Taskpane.Url" DefaultValue="{{ taskpane_url }}"/>
        <bt:Url id="ComposeTaskpane.Url" DefaultValue="{{ compose_taskpane_url }}"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Gudanes"/>
        <bt:String id="PaneButtonLabel" DefaultValue="Guest"/>
        <bt:String id="ComposePaneButtonLabel" DefaultValue="Draft with AI"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="PaneButtonTooltip" DefaultValue="Everything about this guest: bookings, warnings and every email with them"/>
        <bt:String id="ComposePaneButtonTooltip" DefaultValue="Draft a reply from the guest's history and today's real prices, and check it before sending"/>
      </bt:LongStrings>
    </Resources>

    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <!-- The HTML page runs the event handlers in a browser runtime; the
                 JavaScript override is what classic Outlook on Windows loads
                 instead, with no page at all. -->
            <Runtime resid="WebViewRuntime.Url">
              <Override type="javascript" resid="JSRuntime.Url"/>
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <!-- THE SHARED INBOXES. reservations@, experience@ and the rest are
                 shared mailboxes, and without this Outlook offers no add-in at
                 all on an email READ in one: on 19 October 2026 the Apps list
                 beside Forward was empty on a guest's email in experience@,
                 while Draft with AI worked, because compose needs nothing.
                 Microsoft's schema allows it in this 1.1 layer only (Mailbox
                 1.8 for delegate folders, 1.13 for shared mailboxes), and as
                 the first child here. In the 1.0 layer it would make the whole
                 manifest invalid, and the 1.0 layer is only for an Outlook too
                 old to open a shared mailbox's add-ins anyway. -->
            <SupportsSharedFolders>true</SupportsSharedFolders>
            <FunctionFile resid="Commands.Url"/>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="msgReadGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="msgReadOpenPaneButton">
                    <Label resid="PaneButtonLabel"/>
                    <Supertip>
                      <Title resid="PaneButtonLabel"/>
                      <Description resid="PaneButtonTooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <!-- Pinnable: the Guest pane stays open and follows the email
                         chosen, rather than closing each time. The page listens
                         for ItemChanged and redraws for the new email. -->
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="msgComposeGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="msgComposeOpenPaneButton">
                    <Label resid="ComposePaneButtonLabel"/>
                    <Supertip>
                      <Title resid="ComposePaneButtonLabel"/>
                      <Description resid="ComposePaneButtonTooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="ComposeTaskpane.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <!-- PromptUser on Send, never SoftBlock or Block. Under SoftBlock,
                 Outlook's own "taking longer than expected" and "timed out"
                 dialogs offer only Don't Send, so an add-in that does not
                 answer stops every email; on 14 October 2026 that is what
                 happened in Outlook on the web. PromptUser keeps Send Anyway on
                 every one of Outlook's dialogs, whatever the add-in does. A
                 wrong price still stops the email, with the right one named;
                 the person has to choose to send it anyway. -->
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="onNewMessageComposeHandler"/>
                <LaunchEvent Type="OnMessageRecipientsChanged" FunctionName="onMessageRecipientsChangedHandler"/>
                <LaunchEvent Type="OnMessageSend" FunctionName="onMessageSendHandler" SendMode="PromptUser"/>
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url"/>
            </ExtensionPoint>
          </DesktopFormFactor>
          <!-- THE PHONE. Outlook on iOS and Android open an add-in's panel while
               READING only; there is no compose panel on a phone, and Smart
               Alerts (OnMessageSend) do not run there. The read panel carries
               the guest, the drafting and the check; the two compose events
               put a note about the guest at the top of a reply. -->
          <MobileFormFactor>
            <FunctionFile resid="Commands.Url"/>
            <ExtensionPoint xsi:type="MobileMessageReadCommandSurface">
              <Group id="mobileMsgRead">
                <Label resid="GroupLabel"/>
                <Control xsi:type="MobileButton" id="mobileReadOpenPaneButton">
                  <Label resid="PaneButtonLabel"/>
                  <Icon xsi:type="bt:MobileIconList">
                    <bt:Image size="25" scale="1" resid="Icon.25x25"/>
                    <bt:Image size="25" scale="2" resid="Icon.25x25"/>
                    <bt:Image size="25" scale="3" resid="Icon.25x25"/>
                    <bt:Image size="32" scale="1" resid="Icon.32x32"/>
                    <bt:Image size="32" scale="2" resid="Icon.32x32"/>
                    <bt:Image size="32" scale="3" resid="Icon.32x32"/>
                    <bt:Image size="48" scale="1" resid="Icon.48x48"/>
                    <bt:Image size="48" scale="2" resid="Icon.48x48"/>
                    <bt:Image size="48" scale="3" resid="Icon.48x48"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="onNewMessageComposeHandler"/>
                <LaunchEvent Type="OnMessageRecipientsChanged" FunctionName="onMessageRecipientsChangedHandler"/>
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url"/>
            </ExtensionPoint>
          </MobileFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="{{ icons[16] }}"/>
          <bt:Image id="Icon.25x25" DefaultValue="{{ icons[25] }}"/>
          <bt:Image id="Icon.32x32" DefaultValue="{{ icons[32] }}"/>
          <bt:Image id="Icon.48x48" DefaultValue="{{ icons[48] }}"/>
          <bt:Image id="Icon.80x80" DefaultValue="{{ icons[80] }}"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="{{ launchevent_html_url }}"/>
          <bt:Url id="Taskpane.Url" DefaultValue="{{ taskpane_url }}"/>
          <bt:Url id="ComposeTaskpane.Url" DefaultValue="{{ compose_taskpane_url }}"/>
          <bt:Url id="WebViewRuntime.Url" DefaultValue="{{ launchevent_html_url }}"/>
          <bt:Url id="JSRuntime.Url" DefaultValue="{{ launchevent_js_url }}"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Gudanes"/>
          <bt:String id="PaneButtonLabel" DefaultValue="Guest"/>
          <bt:String id="ComposePaneButtonLabel" DefaultValue="Draft with AI"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="PaneButtonTooltip" DefaultValue="Everything about this guest: bookings, warnings and every email with them"/>
          <bt:String id="ComposePaneButtonTooltip" DefaultValue="Draft a reply from the guest's history and today's real prices, and check it before sending"/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
